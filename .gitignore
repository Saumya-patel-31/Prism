# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database — contains chat history, uploaded documents, embeddings,
# and password hashes. Never commit.
/.prism/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# static demo build — restored automatically, only present mid-build
/.demo-static-stash/

# terraform
# .terraform/ is the provider cache (hundreds of MB). The lock file is NOT
# ignored on purpose — committing it pins provider versions across machines.
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
